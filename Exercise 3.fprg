<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercise 3"/>
        <attribute name="authors" value="marvi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-10 02:26:23 PM"/>
        <attribute name="created" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MDE6MTM6MDggUE07MjkwNw=="/>
        <attribute name="edited" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MDI6MjY6MjMgUE07MjszMDE4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;What is your name, please?&quot;" newline="True"/>
            <declare name="UserName" type="String" array="False" size=""/>
            <input variable="UserName"/>
            <output expression="&quot;What is your hourly rate of pay?&quot;" newline="True"/>
            <declare name="HourlyRate" type="Real" array="False" size=""/>
            <input variable="HourlyRate"/>
            <output expression="&quot;How many hours did you work?&quot;" newline="True"/>
            <declare name="HoursWorked" type="Real" array="False" size=""/>
            <input variable="HoursWorked"/>
            <declare name="WeeklyPay" type="Real" array="False" size=""/>
            <assign variable="WeeklyPay" expression="HourlyRate*HoursWorked"/>
            <output expression="&quot;Rate of Pay: &quot;&amp;HourlyRate" newline="True"/>
            <output expression="&quot;Hours this week: &quot;&amp;HoursWorked" newline="True"/>
            <output expression="UserName &amp;&quot;, your pay is &quot;&amp;WeeklyPay &amp;&quot; this week&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
