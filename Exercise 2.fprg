<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercise 2"/>
        <attribute name="authors" value="marvi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-10 01:11:39 PM"/>
        <attribute name="created" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MTI6Mjk6NTMgUE07MjkxNg=="/>
        <attribute name="edited" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MDE6MTE6MzkgUE07MTszMDE3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Please enter a number&quot;" newline="True"/>
            <declare name="FirstNumber" type="Real" array="False" size=""/>
            <input variable="FirstNumber"/>
            <output expression="&quot;Enter another number, please&quot;" newline="True"/>
            <declare name="SecondNumber" type="Real" array="False" size=""/>
            <input variable="SecondNumber"/>
            <output expression="FirstNumber+SecondNumber" newline="True"/>
            <output expression="FirstNumber*SecondNumber" newline="True"/>
            <declare name="Average" type="Real" array="False" size=""/>
            <assign variable="Average" expression="(FirstNumber+SecondNumber)/2"/>
            <output expression="&quot;The average of &quot;&amp;FirstNumber&amp;&quot; and &quot;&amp;SecondNumber&amp;&quot; is &quot;&amp;Average" newline="True"/>
        </body>
    </function>
</flowgorithm>
