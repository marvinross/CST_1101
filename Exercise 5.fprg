<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercise 5"/>
        <attribute name="authors" value="marvi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-10 06:12:04 PM"/>
        <attribute name="created" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MDU6Mjg6MDUgUE07MjkxNA=="/>
        <attribute name="edited" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MDY6MTI6MDQgUE07MTszMDE1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;What is your name?&quot;" newline="True"/>
            <declare name="UserName" type="String" array="False" size=""/>
            <input variable="UserName"/>
            <output expression="&quot;How many times should your name be displayed?&quot;" newline="True"/>
            <declare name="Count" type="Integer" array="False" size=""/>
            <input variable="Count"/>
            <declare name="StartValue" type="Integer" array="False" size=""/>
            <assign variable="StartValue" expression="1"/>
            <declare name="NameRepeat" type="Integer" array="False" size=""/>
            <for variable="NameRepeat" start="StartValue" end="Count" direction="inc" step="1">
                <output expression="&quot;Your name is &quot;&amp;UserName" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
