<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercise 4"/>
        <attribute name="authors" value="marvi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-10 05:24:31 PM"/>
        <attribute name="created" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MDI6Mjg6NTYgUE07MjkxNw=="/>
        <attribute name="edited" value="bWFydmk7REVTS1RPUC0xVDhUTUVVOzIwMjYtMDktMTA7MDU6MjQ6MzEgUE07MTszMDE3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;What is your hourly rate of play?&quot;" newline="True"/>
            <declare name="HourlyRate" type="Real" array="False" size=""/>
            <input variable="HourlyRate"/>
            <output expression="&quot;How many hours did you work?&quot;" newline="True"/>
            <declare name="HoursWorked" type="Real" array="False" size=""/>
            <input variable="HoursWorked"/>
            <output expression="&quot;Does the employer pay OT at time and a half?(y or n)&quot;" newline="True"/>
            <declare name="UserInput" type="String" array="False" size=""/>
            <declare name="OTPay" type="Boolean" array="False" size=""/>
            <input variable="UserInput"/>
            <assign variable="OTPay" expression="UserInput = &quot;y&quot;"/>
            <if expression="OTPay = true">
                <then>
                    <output expression="&quot;Your weekly pay is &quot;&amp;(HoursWorked - 40)*(HourlyRate*1.5)+(40*HourlyRate)" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Your weekly pay is &quot;&amp;HoursWorked*HourlyRate" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
