    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Enter an odd integer, please&quot;" newline="True"/>
            <declare name="Integer1" type="Integer" array="False" size=""/>
            <input variable="Integer1"/>
            <while expression="Integer1 mod 2 = 0">
                <output expression="&quot;That is not an odd number. Try again&quot;" newline="True"/>
                <output expression="&quot;Enter an odd integer, please&quot;" newline="True"/>
                <input variable="Integer1"/>
            </while>
            <output expression="&quot;Good input. Thanks&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
